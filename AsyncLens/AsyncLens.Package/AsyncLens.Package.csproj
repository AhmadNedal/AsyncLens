<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>BlockingAsync.Analyzer</PackageId>
		<PackageVersion>0.1.0-preview.1</PackageVersion>
		<Authors>ahmad</Authors>
		<Description>Roslyn analyzer that detects blocking on Tasks (.Result, .Wait(), GetAwaiter().GetResult()) and offers code fixes to await instead.</Description>
		<PackageTags>roslyn analyzer async await task sync-over-async deadlock</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>Preview release: ASYNC001 with code fixes.</PackageReleaseNotes>
		<Copyright>Copyright (c) ahmad</Copyright>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<DevelopmentDependency>true</DevelopmentDependency>
		<NoPackageAnalysis>true</NoPackageAnalysis>

		<!-- <PackageLicenseExpression>MIT</PackageLicenseExpression> -->
		<!-- <RepositoryUrl>https://github.com/YOU/REPO</RepositoryUrl> -->
		<!-- <PackageProjectUrl>https://github.com/YOU/REPO</PackageProjectUrl> -->

		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzersToOutput</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\AsyncLens.CodeFixes\AsyncLens.CodeFixes.csproj" />
		<ProjectReference Include="..\AsyncLens\AsyncLens.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Update="tools\*.ps1" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="" />
	</ItemGroup>

	<Target Name="_AddAnalyzersToOutput">
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(OutputPath)\AsyncLens.dll" PackagePath="analyzers/dotnet/cs" />
			<TfmSpecificPackageFile Include="$(OutputPath)\AsyncLens.CodeFixes.dll" PackagePath="analyzers/dotnet/cs" />
		</ItemGroup>
	</Target>

</Project>